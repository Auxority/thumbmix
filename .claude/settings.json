{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/guard-generated.sh" }]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/check-before-push.sh",
            "timeout": 600,
            "statusMessage": "Lint and unused-code check before push"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/format-swift.sh" }]
      }
    ]
  }
}
